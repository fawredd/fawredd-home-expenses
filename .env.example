# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fawredd_local
DB_SCHEMA=fawredd_home_expenses

# Redis Configuration (for job queue and caching)
REDIS_URL=redis://localhost:6379

# AI Configuration
# Local Ollama (default)
OLLAMA_BASE_URL=http://localhost:11434

# Remote AI Provider (Optional fallback)
# Available options: openai, anthropic, etc.
AI_PROVIDER=ollama
# AI_API_KEY=your_api_key_here

# Storage Configuration
# For Phase 1: local filesystem
STORAGE_PATH=./storage/documents

# Logging
LOG_LEVEL=info

# Optional default user identity for local development
# DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000

# Environment
NODE_ENV=development

# ------------------------
# Clerk (Authentication)
# ------------------------
# Register an app at https://clerk.com and set the values below for local dev.
# Typically you will need a publishable frontend key (NEXT_PUBLIC_*) and a secret server key.
CLERK_SECRET_KEY=key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=key